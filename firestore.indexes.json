{
  "//": "Index composites requis. Déployer avec : firebase deploy --only firestore:indexes",
  "indexes": [
    {
      "//": "Onglet Confessions — getConfessions()",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isAnonymous", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Rumeurs d'un profil — getPostsByUser()",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Salon d'un tag — getPostsByTag()",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "tags", "arrayConfig": "CONTAINS" },
        { "fieldPath": "timestamp", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Suppression de compte — commentaires laissés partout",
      "collectionGroup": "comments",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Changement de pseudo et suppression de compte — messages envoyés",
      "collectionGroup": "messages",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "senderId", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Mes paris, toutes rumeurs confondues — un seul écouteur pour l'app",
      "collectionGroup": "bets",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Éventail de notifications — listenToNotifications() et markAllRead().",
      "//2": "Sans lui les deux requêtes sont REFUSÉES : la cloche reste vide et",
      "//3": "« Tout lire » ne fait rien. À déployer AVANT de livrer l'APK.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetUserId", "order": "ASCENDING" },
        { "fieldPath": "timestamp", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
