# Modèle de configuration des Cloud Functions.
#
# Copier en `functions/.env` — qui n'est PAS versionné (functions/.gitignore).
# Sans ce fichier, les valeurs par défaut du code s'appliquent, et la valeur
# par défaut de la purge est `false` : elle ne supprime rien.
#
# ⚠️ Aucun secret ici. Ce fichier est versionné, donc lisible par quiconque
# ouvre le dépôt — qui est public. Les clés d'API passent par
# `firebase functions:secrets:set`, jamais par ce fichier.

# Purge des médias Cloudinary (voir functions/medias.js).
#
# false — la fonction journalise ce qu'elle supprimerait, sans rien supprimer.
# true  — elle supprime pour de bon. Irréversible.
#
# À laisser sur false jusqu'à avoir relu quelques jours de
# `firebase functions:log` et vérifié que les identifiants annoncés sont bien
# ceux qu'on attend.
CLOUDINARY_SUPPRESSION_REELLE=false
