rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  Règles de sécurité Askip
//
//  À déployer :   firebase deploy --only firestore:rules
//                 ou console Firebase → Firestore → Règles → coller → Publier
//
//  Principe : le client peut écrire ce qui le concerne, et uniquement les
//  champs partagés qui ont un sens (réagir, voter, commenter). Tout le reste
//  — statut admin, bannissement, épinglage — est verrouillé.
//
//  L'UID ci-dessous est celui de l'administrateur (console Firebase →
//  Authentication → Users). Il doit correspondre à ADMIN_UID dans
//  utils/AdminConfig.kt.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && uid() in [
        'ckCTisQMWKWbnoElnUjO2x4vKxy2'
      ];
    }

    // Le compte n'est pas banni : un banni peut encore lire, pas écrire.
    // Les deux accès portent sur le même document, donc Firestore ne les
    // compte qu'une fois — y compris dans un lot de 400 écritures.
    function notBanned() {
      return !exists(/databases/$(database)/documents/profiles/$(uid()))
        || get(/databases/$(database)/documents/profiles/$(uid()))
             .data.get('isBanned', false) != true;
    }

    function canWrite() {
      return signedIn() && notBanned();
    }

    /** Les champs modifiés par cette écriture. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** L'écriture ne touche QUE des champs de la liste autorisée. */
    function onlyChanges(allowed) {
      return changed().hasOnly(allowed);
    }

    /**
     * Réagir à un message : on ne touche que sa propre clé.
     *
     * `reactions` associe un UID à une réaction. Comparer les deux cartes clé
     * par clé autorise tout le monde à réagir sans permettre à personne
     * d'effacer la réaction d'un autre.
     *
     * Le `get(..., {})` n'est pas une précaution de style : la carte est
     * absente d'un message qui n'a jamais reçu de réaction, et Firestore la
     * supprime entièrement quand on retire la dernière. Lire le champ
     * directement ferait échouer la règle dans ces deux cas — dont celui,
     * très ordinaire, où l'on retire la réaction qu'on venait de poser.
     */
    function touchesOwnReactionOnly() {
      return request.resource.data.get('reactions', {})
               .diff(resource.data.get('reactions', {}))
               .affectedKeys().hasOnly([uid()]);
    }

    /**
     * L'utilisateur ne s'ajoute ou ne se retire que lui-même d'un tableau.
     *
     * Le deuxième cas couvre les rumeurs publiées avant l'ajout du
     * Rumeur-mètre : le champ n'existe pas encore sur le document, et sans
     * cette branche voter dessus serait refusé.
     */
    function togglesSelfOnly(field) {
      return !(field in changed())
        || (field in resource.data
            && request.resource.data[field].toSet()
                 .difference(resource.data[field].toSet()).hasOnly([uid()])
            && resource.data[field].toSet()
                 .difference(request.resource.data[field].toSet()).hasOnly([uid()]))
        || (!(field in resource.data)
            && request.resource.data[field].hasOnly([uid()]));
    }

    /**
     * Un compteur bouge d'un cran, jamais d'un chiffre inventé.
     *
     * Firestore applique `FieldValue.increment` AVANT d'évaluer les règles :
     * `request.resource.data[field]` porte donc déjà la valeur finale. C'est
     * le même mécanisme que `arrayUnion`, sur lequel repose [togglesSelfOnly].
     */
    function movesByOne(field) {
      return !(field in changed())
        || request.resource.data[field] == resource.data.get(field, 0) + 1
        || request.resource.data[field] == resource.data.get(field, 0) - 1;
    }

    /** Idem, mais dans un seul sens : un vote ne se retire pas. */
    function risesByOne(field) {
      return !(field in changed())
        || request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    /**
     * Un sondage ne se vote qu'une fois.
     *
     * Le compteur ne peut bouger que par la même écriture qui fait entrer la
     * personne dans `pollVoters`. Sans cette condition, `togglesSelfOnly`
     * laissait passer une écriture qui n'ajoute personne — et le compteur
     * montait autant de fois qu'on appuyait.
     */
    function castsOnePollVote() {
      return (!('pollVotes1' in changed()) && !('pollVotes2' in changed()))
        || (!(uid() in resource.data.get('pollVoters', []))
            && uid() in request.resource.data.pollVoters);
    }

    // ── Profils ────────────────────────────────────────────────────────────

    match /profiles/{userId} {
      allow read: if signedIn();

      // On crée uniquement son propre profil, sans se déclarer admin.
      allow create: if signedIn()
        && userId == uid()
        && request.resource.data.isAdmin != true
        && request.resource.data.isBanned != true;

      allow update: if
        // Son propre profil : tout sauf les champs de statut.
        //
        // `hasBadgeENI` est le seul champ de statut qu'on se pose soi-même,
        // mais jamais librement : il doit rester d'accord avec la classe
        // déclarée. Le bloquer entièrement rendait la sauvegarde du profil
        // impossible dès qu'on choisissait sa classe pour la première fois —
        // le formulaire écrit les deux champs ensemble.
        (canWrite() && userId == uid()
          && !changed().hasAny(['isAdmin', 'isBanned'])
          && (!('hasBadgeENI' in changed())
              || request.resource.data.hasBadgeENI
                 == (request.resource.data.classeENI != '')))

        // La réputation est modifiée par les autres (vote crédible / Scoop).
        // Compromis assumé : sans Cloud Function, seul le client peut
        // incrémenter le clout de l'auteur. On restreint donc au minimum —
        // ces trois champs et rien d'autre. Passer par une Cloud Function
        // dès que le projet est sur le plan Blaze.
        || (canWrite()
          && onlyChanges(['clout', 'confirmedRumors', 'debunkedRumors']))

        // Supprimer un badge le retire de la panoplie de tous ceux qui le
        // portaient — donc d'un profil qui n'est pas le sien.
        //
        // Uniquement un RETRAIT : la différence dans l'autre sens doit être
        // vide, ce qui interdit de décerner à quiconque un badge qu'il n'a
        // pas créé. Reste possible : retirer un badge cosmétique à quelqu'un
        // par malice. C'est réversible d'un geste, et c'est le prix à payer
        // tant que le ménage se fait depuis le téléphone.
        || (canWrite()
          && onlyChanges(['badgeIds'])
          && request.resource.data.badgeIds.toSet()
               .difference(resource.data.get('badgeIds', []).toSet()).size() == 0)

        // L'admin peut tout, y compris accorder un badge ou bannir.
        || isAdmin();

      allow delete: if signedIn() && (userId == uid() || isAdmin());

      match /achievements/{achievementId} {
        allow read: if signedIn();
        allow write: if signedIn() && userId == uid();
      }
    }

    // ── Rumeurs ────────────────────────────────────────────────────────────

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if canWrite()
        && request.resource.data.userId == uid()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 1000
        && request.resource.data.isPinned == false
        && request.resource.data.commentCount == 0
        && request.resource.data.keysBy.size() == 0
        && request.resource.data.repliedBy.size() == 0
        // Un post neuf ne peut pas arriver avec des votes déjà dedans.
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.credibleBy.size() == 0
        && request.resource.data.fakeBy.size() == 0
        && request.resource.data.scoopBy.size() == 0;

      allow update: if
        // L'auteur corrige son texte — et rien d'autre.
        //
        // `username` en fait partie : changer de pseudo le répercute sur tout
        // ce qu'on a déjà publié. Sans lui, renommer son compte échouait en
        // silence et les anciennes rumeurs gardaient l'ancien nom.
        (canWrite() && resource.data.userId == uid()
          && onlyChanges(['content', 'tags', 'isEdited', 'username']))

        // N'importe qui réagit, tranche, offre son Scoop, donne sa clé ou vote
        // au sondage — mais uniquement en s'ajoutant ou se retirant lui-même.
        || (canWrite()
          && onlyChanges([
               'likedBy', 'fireBy', 'lolBy', 'shockBy', 'eyesBy',
               'credibleBy', 'fakeBy', 'scoopBy', 'keysBy', 'repliedBy',
               'pollVoters', 'pollVotes1', 'pollVotes2',
               'commentCount',
               'chainCount', 'chainAuthors', 'chainLastContent', 'chainLastAuthor'
             ])
          && togglesSelfOnly('likedBy')
          && togglesSelfOnly('fireBy')
          && togglesSelfOnly('lolBy')
          && togglesSelfOnly('shockBy')
          && togglesSelfOnly('eyesBy')
          && togglesSelfOnly('credibleBy')
          && togglesSelfOnly('fakeBy')
          && togglesSelfOnly('scoopBy')
          && togglesSelfOnly('keysBy')
          && togglesSelfOnly('repliedBy')
          && togglesSelfOnly('chainAuthors')
          && togglesSelfOnly('pollVoters')
          // Les compteurs suivent les tableaux au lieu de flotter librement.
          && movesByOne('commentCount')
          && risesByOne('chainCount')
          && risesByOne('pollVotes1')
          && risesByOne('pollVotes2')
          && castsOnePollVote())

        // Seul l'admin épingle.
        || isAdmin();

      allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());

      // ── La capsule scellée ───────────────────────────────────────────────
      // Le cœur du mécanisme. Le serveur refuse de servir le contenu tant que
      // l'heure n'est pas venue : cacher le texte à l'affichage n'aurait rien
      // protégé, il suffisait de lire la base.
      match /sealed/{doc} {
        allow read: if signedIn() && (
          // L'auteur peut relire sa propre capsule.
          resource.data.authorId == uid()
          // L'heure est passée — comparaison faite par le serveur.
          || request.time.toMillis() >= resource.data.unsealAt
          // Ou le campus a réuni assez de clés.
          || (resource.data.keysNeeded > 0
              && get(/databases/$(database)/documents/posts/$(postId))
                   .data.get('keysBy', []).size() >= resource.data.keysNeeded)
        );
        allow create: if canWrite() && request.resource.data.authorId == uid();
        // Une capsule ne se réécrit pas : sinon on pourrait changer le contenu
        // après avoir vu qui a donné sa clé.
        allow update: if false;
        allow delete: if signedIn() && (resource.data.authorId == uid() || isAdmin());
      }

      // ── Le Téléphone arabe ───────────────────────────────────────────────
      match /links/{linkId} {
        allow read: if signedIn();
        allow create: if canWrite()
          && request.resource.data.userId == uid()
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 140
          // Un seul maillon par personne, sept au total. Les `get(champ,
          // défaut)` couvrent les rumeurs d'avant la chaîne : sans eux, la
          // règle ne renvoie pas faux, elle échoue.
          && !(uid() in get(/databases/$(database)/documents/posts/$(postId))
                          .data.get('chainAuthors', []))
          && get(/databases/$(database)/documents/posts/$(postId))
               .data.get('chainCount', 0) < 7;
        // Un maillon posé ne se réécrit pas : la chaîne serait falsifiable.
        allow update: if false;
        allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
      }

      // ── Le Pari ──────────────────────────────────────────────────────────
      match /bets/{betUid} {
        allow read: if signedIn();
        // L'id du document est l'UID : impossible de parier pour quelqu'un
        // d'autre, ni deux fois sur la même rumeur.
        allow create: if canWrite()
          && betUid == uid()
          && request.resource.data.userId == uid()
          && request.resource.data.settled == false
          && request.resource.data.stake is int
          && request.resource.data.stake >= 1
          && request.resource.data.stake <= 3;
        // On ne règle que son propre pari, et une seule fois.
        allow update: if canWrite()
          && betUid == uid()
          && resource.data.settled == false
          && onlyChanges(['settled', 'won', 'payout']);
        allow delete: if isAdmin();
      }

      // ── Le droit de réponse ──────────────────────────────────────────────
      // Les trois verbes sont séparés à dessein. `allow write` couvrait aussi
      // la suppression, où `request.resource` vaut null : lire `.data` dessus
      // ne renvoie pas faux, ça fait échouer la règle. Retirer sa réponse
      // était donc refusé.
      match /replies/{replyUid} {
        allow read: if signedIn();
        allow create, update: if canWrite()
          && replyUid == uid()
          && request.resource.data.userId == uid();
        allow delete: if signedIn() && (replyUid == uid() || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if canWrite()
          && request.resource.data.userId == uid()
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 500;
        allow update: if canWrite()
          && (resource.data.userId == uid() || onlyChanges(['likedBy']));
        // L'auteur de la rumeur peut faire le ménage chez lui. C'est ce qui
        // permet à la suppression de compte d'emporter les commentaires des
        // autres sous ses propres rumeurs, au lieu de les laisser orphelins.
        allow delete: if signedIn() && (
          resource.data.userId == uid()
          || get(/databases/$(database)/documents/posts/$(postId)).data.userId == uid()
          || isAdmin()
        );
      }
    }

    // ── Stories ────────────────────────────────────────────────────────────

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.userId == uid()
        && request.resource.data.content.size() <= 200;
      // L'auteur répercute son changement de pseudo ; n'importe qui marque
      // la story comme vue.
      allow update: if canWrite() && (
        (resource.data.userId == uid() && onlyChanges(['username']))
        || onlyChanges(['viewedBy'])
      );
      allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Messages privés ────────────────────────────────────────────────────

    match /conversations/{convId} {
      // `get` et `list` sont séparés à dessein.
      //
      // Ouvrir une conversation commence par vérifier si elle existe. Sur un
      // document absent, `resource` vaut null : lire `resource.data` fait
      // échouer la règle, et Firestore répond « accès refusé » au lieu de
      // « n'existe pas ». Démarrer une première conversation était donc
      // impossible. Un document absent ne contient rien à protéger.
      allow get: if signedIn()
        && (resource == null || uid() in resource.data.participants);
      // La liste, elle, reste filtrée : la requête de l'app porte un
      // `whereArrayContains('participants', moi)`, que Firestore sait vérifier.
      allow list: if signedIn() && uid() in resource.data.participants;

      allow create: if canWrite() && uid() in request.resource.data.participants;
      // Un participant met à jour l'aperçu, les compteurs de non-lus et les
      // pseudos — mais ne réécrit ni l'identifiant ni la liste des présents.
      allow update: if canWrite()
        && uid() in resource.data.participants
        && !changed().hasAny(['id', 'participants']);
      allow delete: if signedIn() && uid() in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/conversations/$(convId))
                        .data.participants;
        allow create: if canWrite()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/conversations/$(convId))
                        .data.participants;
        // Un pseudo qui change doit se répercuter sur les anciens messages.
        // Et tout le monde réagit — mais chacun ne pose que sa propre clé :
        // la carte `reactions` est indexée par UID, donc la règle peut le
        // vérifier au lieu de faire confiance au client.
        allow update: if canWrite()
          && (resource.data.senderId == uid()
              || onlyChanges(['senderUsername'])
              || (onlyChanges(['reactions']) && touchesOwnReactionOnly()));
        allow delete: if signedIn() && (resource.data.senderId == uid() || isAdmin());
      }
    }

    // ── Groupes ────────────────────────────────────────────────────────────

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if canWrite() && uid() in request.resource.data.members;
      // Un membre écrit l'aperçu, s'ajoute ou se retire, met à jour son nom —
      // mais ne se déclare pas fondateur du groupe.
      allow update: if canWrite() && (
        isAdmin()
        || (uid() in resource.data.members
            && !changed().hasAny(['id', 'createdBy']))
      );
      allow delete: if signedIn()
        && (resource.data.createdBy == uid() || isAdmin());

      match /messages/{messageId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if canWrite()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        // Même règle que pour les messages privés : chacun ne pose que sa
        // propre réaction, et un pseudo renommé se répercute partout.
        allow update: if canWrite()
          && (resource.data.senderId == uid()
              || onlyChanges(['senderUsername'])
              || (onlyChanges(['reactions']) && touchesOwnReactionOnly()));
        allow delete: if signedIn() && (resource.data.senderId == uid() || isAdmin());
      }
    }

    // ── Notifications ──────────────────────────────────────────────────────

    match /notifications/{notifId} {
      // On lit les siennes — et celles qu'on a soi-même envoyées, sans quoi
      // ni le changement de pseudo ni la suppression de compte ne peuvent
      // les retrouver pour les corriger ou les effacer.
      allow read: if signedIn()
        && (resource.data.get('targetUserId', '') == uid()
            || resource.data.get('fromUserId', '') == uid());
      // Mais on peut en créer pour les autres (mention, message, nouveau post).
      allow create: if canWrite() && request.resource.data.fromUserId == uid();
      // Le destinataire marque comme lu ; l'expéditeur ne corrige que le
      // pseudo qu'il y a laissé.
      //
      // Le champ s'appelle bien `isRead` en base : sans les annotations
      // @PropertyName du modèle, Firestore ampute le préfixe `is` du getter
      // et écrit `read` — la règle refusait alors chaque « tout lire ».
      allow update: if signedIn() && (
        (resource.data.targetUserId == uid() && onlyChanges(['isRead']))
        || (resource.data.fromUserId == uid() && onlyChanges(['fromUsername']))
      );
      allow delete: if signedIn()
        && (resource.data.targetUserId == uid()
            || resource.data.fromUserId == uid()
            || isAdmin());
    }

    // ── Badges ─────────────────────────────────────────────────────────────

    match /badges/{badgeId} {
      allow read: if signedIn();
      allow create: if canWrite()
        && request.resource.data.createdBy == uid()
        && request.resource.data.name != 'admin';
      allow update, delete: if signedIn()
        && (resource.data.createdBy == uid() || isAdmin());
    }

    // ── Signalements ───────────────────────────────────────────────────────

    match /reports/{reportId} {
      // Personne ne lit les signalements des autres, sauf l'admin.
      allow read: if isAdmin();
      allow create: if canWrite() && request.resource.data.reporterId == uid();
      allow update, delete: if isAdmin();
    }

    // ═════════════════════════════════════════════════════════════════════
    //  Requêtes de groupe de collections
    //
    //  Une requête `collectionGroup` n'est PAS couverte par les règles
    //  imbriquées ci-dessus : il lui faut une règle à caractère générique
    //  récursif, sinon elle est refusée en bloc. Chacune de celles-ci
    //  reprend exactement le filtre que l'app applique, ce qui permet à
    //  Firestore de prouver qu'on ne lit rien d'autre que le sien.
    // ═════════════════════════════════════════════════════════════════════

    // Mes paris, sur toutes les rumeurs à la fois.
    match /{path=**}/bets/{betId} {
      allow read: if signedIn() && resource.data.userId == uid();
    }

    // Mes commentaires, pour les renommer ou les effacer avec mon compte.
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn() && resource.data.userId == uid();
    }

    // Mes messages, privés comme de groupe, pour la même raison. La lecture
    // n'ouvre rien de neuf : ce sont les messages que j'ai écrits moi-même.
    match /{path=**}/messages/{messageId} {
      allow read: if signedIn() && resource.data.senderId == uid();
    }

    // Tout ce qui n'est pas explicitement autorisé est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
